{
  "name": "akoizo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "communities:sync": "node scripts/sync-communities.mjs",
    "predev": "npm run communities:sync",
    "prebuild": "npm run communities:sync",
    "pretypecheck": "npm run communities:sync",
    "pretest": "npm run communities:sync",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/enrollment-env.mjs --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src scripts tests documents README.md BACKLOG.md *.json next.config.ts",
    "format:check": "prettier --check src scripts tests documents README.md BACKLOG.md *.json next.config.ts"
  },
  "dependencies": {
    "@tursodatabase/serverless": "^1.4.1",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.14.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  }
}
